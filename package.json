{
  "name": "@cocreate/server-usage",
  "version": "1.9.0",
  "description": "Server-side usage metering and billing ledgers for CoCreate organizations.",
  "keywords": [
    "cocreate-server-usage",
    "server-usage",
    "usage-metering",
    "billing",
    "ledger",
    "payments",
    "credits",
    "organization-balance",
    "pricing",
    "consumption",
    "webhooks",
    "server"
  ],
  "type": "module",
  "cocreate": {
    "environment": [
      "server"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "Server-side metering, immutable usage and credit ledgers, payment recording, and organization balance projections for CoCreate.",
      "source": "src/index.js",
      "api": {
        "exports": [
          "calculatePayloadBytes",
          "calculatePrice",
          "init"
        ]
      }
    }
  },
  "main": "./src/index.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/CoCreate-server-usage.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreateJS/CoCreate-server-usage/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/server-usage",
  "scripts": {
    "demo": "PORT=5000 node demo/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@cocreate/config": "^1.21.0",
    "@cocreate/crud-server": "^1.42.0",
    "@cocreate/utils": "^1.54.0"
  }
}
